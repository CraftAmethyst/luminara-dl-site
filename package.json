{
  "name": "luminara-dl-site",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run validate:data && vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "validate:data": "node scripts/validate-data.mjs",
    "data:refresh": "node scripts/fetch-releases.mjs",
    "data:check": "node scripts/fetch-releases.mjs --check",
    "verify:links": "node scripts/verify-links.mjs",
    "assets:generate": "node scripts/generate-assets.mjs",
    "deploy:manual": "npm run build && wrangler pages deploy dist --project-name luminara-dl"
  },
  "dependencies": {
    "vue": "^3.5.44"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^22",
    "@vitejs/plugin-vue": "^6.0.10",
    "sharp": "^0.35.5",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.3.13",
    "wrangler": "^4.151.1"
  }
}
